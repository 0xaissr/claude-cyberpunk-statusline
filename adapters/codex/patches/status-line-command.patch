+fn status_line_from_command(command: &str, cwd: &Path) -> Option<Line<'static>> {
+    let output = Command::new("sh")
+        .arg("-c")
+        .arg(command)
+        .current_dir(cwd)
+        .output()
+        .ok()?;
+    if !output.status.success() {
+        return None;
+    }
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let line = stdout.lines().next()?.trim_end();
+    if line.trim().is_empty() {
+        return None;
+    }
+
+    Some(ansi_escape_line(line))
+}
